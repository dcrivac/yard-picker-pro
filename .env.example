# Copy to .env.php on the SiteGround server (chmod 600) and fill in.
# api.php, ebay.php, and ebay-deletion.php require() it if present,
# otherwise they fall back to getenv().
#
# <?php
# putenv('ANTHROPIC_API_KEY=sk-ant-...');
# putenv('EBAY_VERIFICATION_TOKEN=any-random-32-to-80-char-string-alnum-or-_-or--');
# putenv('EBAY_CLIENT_ID=YourApp-YourName-PRD-...');     // App ID from developer.ebay.com/my/keys
# putenv('EBAY_CLIENT_SECRET=PRD-...');                  // Cert ID from same page
# putenv('DAILY_COST_CEILING_USD=5');                    // Optional. Default $5/day. Anthropic spend cap across all users.
# putenv('DB_HOST=localhost');                           // MySQL host (SiteGround: usually localhost)
# putenv('DB_NAME=dbxxxxxxx_yardpicker');                // Database name from Site Tools > MySQL
# putenv('DB_USER=uxxxxxxx_yp');                         // Database user
# putenv('DB_PASS=your-db-password');                    // Database user password
# putenv('FREE_MONTHLY=5');                              // Optional. Free analyses per account per month. Default 5.
# putenv('STRIPE_SECRET_KEY=sk_test_...');               // Stripe secret key (test or live) from dashboard.stripe.com/apikeys
# putenv('STRIPE_WEBHOOK_SECRET=whsec_...');              // Signing secret from the webhook endpoint you create in Stripe
